{
  "manifest_version": 3,
  "name": "Genhead Time Tracker",
  "version": "1.0.0",
  "description": "Automatically tracks time spent in Genhead client sub-accounts",
  "permissions": [
    "tabs",
    "idle",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://app.genhead.com/*",
    "https://timesheet.genhead.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.genhead.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
